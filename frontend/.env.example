# Public Supabase project configuration for email magic-link auth.
# Safe for the browser: this is the anon/publishable key, never service_role.
VITE_SUPABASE_URL=https://bikddyoeudmwnozjeqyo.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Set true only after Google is enabled under Supabase Auth > Sign In / Providers.
VITE_SUPABASE_GOOGLE_ENABLED=false

# API base URL used by Vite locally (production is set in Vercel).
VITE_API_URL=http://127.0.0.1:8001
