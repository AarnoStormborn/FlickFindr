# TMDB
TMDB_API_KEY=

# S3 destination
S3_BUCKET=
# (alias: AWS_S3_BUCKET_NAME — both are read)
AWS_REGION=
# Credentials: either the env vars below or ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Window
START_YEAR=1980
# END_YEAR=            # defaults to current year
MIN_VOTE_COUNT=50

# Memory / throughput knobs (Pi ~800MB: defaults are conservative)
BATCH_ROWS=10000
CONCURRENCY=6

# Local state
DB_PATH=ingest.db
TMP_DIR=.tmp
S3_PREFIX=movies

# Smoke-test knobs (0 = unlimited)
LIMIT=0
PAGE_CAP=0