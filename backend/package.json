{
  "name": "flickfindr-backend",
  "version": "2.0.0",
  "description": "FlickFindr API — TypeScript backend (Fastify + Postgres/pgvector + Pi SDK agents)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx scripts/ingest-csv.ts",
    "embeddings": "tsx scripts/generate-embeddings.ts",
    "init:db": "tsx scripts/init-db.ts",
    "check": "tsx scripts/check.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@fastify/cors": "^11.0.1",
    "@huggingface/transformers": "^4.2.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pino": "^9.0.0",
    "typebox": "^1.3.18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
