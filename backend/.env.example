# FlickFindr backend — environment template (dev defaults)
# Copy to .env (or export) and adjust for your setup.

# PostgreSQL (matches docker-compose dev defaults)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flickfindr
DB_USER=flickfindr
DB_PASSWORD=flickfindr

# Redis (reserved for future queue use)
REDIS_URL=redis://localhost:6380

# API
PORT=8001
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# TMDB (free API key: https://www.themoviedb.org/settings/api)
# Required by `npm run fetch:movies`. Optional tuning:
#   START_YEAR=1980 END_YEAR=2026 MIN_VOTE_COUNT=50 TMDB_PAGE_CAP=0 TMDB_CONCURRENCY=6
TMDB_API_KEY=

# Pi SDK agents (query parsing + chat UI). Turn off to run embedding-only search.
AGENT_ENABLED=true

# Command Code provider key — required for the agent (concierge + query parsing).
# The provider itself is declared in backend/pi-agent/models.json.
# Without it, agent features report "not configured" and search uses the raw query.
COMMAND_CODE_API_KEY=

# Optional: pin one model ("provider/id"). Default is the free Laguna model,
# then the built-in fallback list in src/config.ts.
# PI_MODEL=commandcode/poolside/laguna-s-2.1-free

# Optional: override the ordered fallbacks (comma-separated).
# AGENT_MODEL_FALLBACKS=commandcode/poolside/laguna-s-2.1-free,commandcode/deepseek/deepseek-v4-flash

# Optional: use a different models.json instead of the bundled one.
# PI_MODELS_PATH=/absolute/path/to/models.json

# Timeouts (ms)
AGENT_QUERY_TIMEOUT_MS=30000
CHAT_TIMEOUT_MS=120000