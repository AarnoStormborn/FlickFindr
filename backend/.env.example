# FlickFindr backend — environment template (dev defaults)
# Copy to .env (or export) and adjust for your setup.

# PostgreSQL (matches docker-compose dev defaults)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flickfindr
DB_USER=flickfindr
DB_PASSWORD=flickfindr

# Redis (reserved for future queue use)
REDIS_URL=redis://localhost:6380

# API
PORT=8001
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# TMDB (free API key: https://www.themoviedb.org/settings/api)
# Required by `npm run fetch:movies`. Optional tuning:
#   START_YEAR=1980 END_YEAR=2026 MIN_VOTE_COUNT=50 TMDB_PAGE_CAP=0 TMDB_CONCURRENCY=6
TMDB_API_KEY=

# Pi SDK agents (query parsing + chat). Turn off to run embedding-only search.
AGENT_ENABLED=true
# Optional: pin a model, e.g. anthropic/claude-opus-4-5 (default: first available)
# PI_MODEL=
# Timeouts (ms)
AGENT_QUERY_TIMEOUT_MS=30000
CHAT_TIMEOUT_MS=120000