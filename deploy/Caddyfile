# FlickFindr production Caddy config — API host only.
# Frontend is served by Vercel; this Caddy instance fronts the backend API.
# {$API_DOMAIN} is the API's public domain (e.g. api.flickfindr.example.com).
{$API_DOMAIN} {
	# All API traffic -> backend (Fastify on :8000 inside the network)
	handle {
		reverse_proxy backend:8000
	}

	# Reasonable security headers (hobby-grade)
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
