# FlickFindr production environment template.
# Copy to deploy/.env and fill in real values. NEVER commit real secrets.

# ---- API host (Oracle VPS) ----
# The API's public domain (fronted by Caddy with auto-HTTPS).
# Example: api.flickfindr.example.com
API_DOMAIN=api.flickfindr.example.com

# ---- Browser origins allowed to call the API (Vercel app + any domain) ----
# Comma-separated list. Must include your Vercel app URL exactly.
# Example: https://flickfindr.vercel.app,https://flickfindr.example.com
CORS_ORIGINS=https://your-app.vercel.app

# ---- Postgres ----
POSTGRES_USER=flickfindr
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=flickfindr

# ---- Backend ----
LOG_LEVEL=info

# Agent features (search intent parsing). true = enabled (uses LLM, costs a
# little per search); false = plain search, no LLM calls.
AGENT_ENABLED=true
# Pin the model used by the agent. Leave empty to use the first available.
PI_MODEL=
AGENT_QUERY_TIMEOUT_MS=30000

# TMDB key (used by ingest tools on this box, if any)
TMDB_API_KEY=

# ---- Deploy / CI ----
# SSH details used by .github/workflows/deploy.yml to reach the VPS.
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=22
