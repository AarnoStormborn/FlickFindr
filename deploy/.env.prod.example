# FlickFindr production environment template.
# Copy to deploy/.env and fill in real values. NEVER commit real secrets.

# ---- App ----
# Your real domain (Caddy needs it for HTTPS). Example: flickfindr.example.com
APP_DOMAIN=flickfindr.example.com
# Public URL used for CORS (must match APP_DOMAIN exactly, no trailing slash)
APP_URL=https://flickfindr.example.com

# ---- Postgres ----
POSTGRES_USER=flickfindr
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=flickfindr

# ---- Backend ----
LOG_LEVEL=info

# Agent features (search intent parsing). true = enabled (uses LLM, costs a
# little per search); false = plain search, no LLM calls.
AGENT_ENABLED=true
# Pin the model used by the agent. Leave empty to use the first available.
# Example (cheap): PI_MODEL=deepseek/deepseek-v4-flash  (pick your sub model)
PI_MODEL=
AGENT_QUERY_TIMEOUT_MS=30000

# TMDB key (used by ingest tools on this box, if any)
TMDB_API_KEY=

# ---- Deploy / CI ----
# SSH details used by .github/workflows/deploy.yml to reach the VPS.
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=22
